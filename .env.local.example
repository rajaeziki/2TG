# Public address of the site (used for sitemap, canonical and language links). Set to your real domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4 measurement ID (optional). Leave empty to disable analytics.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Chatbot provider: any OpenAI-compatible chat endpoint.
# Default (no setup needed): Pollinations, free and keyless, but can be slow or rate limited.
#
# More reliable free option: Groq (create a free key at https://console.groq.com/keys).
# Copy this file to .env.local and uncomment:
# CHAT_API_URL=https://api.groq.com/openai/v1/chat/completions
# CHAT_API_KEY=your_groq_key_here
# CHAT_MODEL=llama-3.1-8b-instant
